    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.21.0",
    "server-only": "^0.0.1",
