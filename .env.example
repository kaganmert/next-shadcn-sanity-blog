# Warning: this file is committed. Never put real secrets here.
# Copy to `.env.local` for local development; set the same names in Vercel.

# Sanity project (public, safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity viewer token for draft mode, Live preview and Visual Editing (server only)
SANITY_API_READ_TOKEN=

# Optional: canonical site URL for metadata, sitemap, RSS and OG images
# (e.g. https://example.com). On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=

# Optional: shows your GitHub contributions on the home page, together with
# "GitHub username" in Settings. A fine-grained token with no permissions is enough.
GITHUB_TOKEN=
